{
  "id": "steps-checklist",
  "name": "Step-by-Step Workflow & Checklist",
  "version": "1.0.0",
  "kind": "static",
  "description": "Actionable 3-5 step workflow or engineering checklist card with step badges, concise step copy, and outcome footer.",
  "distillationHint": "Turn a tutorial, runbook, or guide into 3-5 sequential steps (<= 95 chars per step). Start each step with a strong imperative verb.",
  "tags": ["steps", "checklist", "howto", "workflow", "x", "linkedin", "instagram"],
  "defaultSize": "square",
  "supportedSizes": ["square", "portrait", "grid-3x4", "x", "linkedin", "og", "story"],
  "defaultTheme": "blueprint",
  "themes": {
    "blueprint": {
      "name": "Blueprint Dark",
      "background": "#070c18",
      "surface": "#0f172a",
      "surfaceElevated": "#1e293b",
      "textPrimary": "#f8fafc",
      "textSecondary": "#cbd5e1",
      "textMuted": "#94a3b8",
      "accent": "#38bdf8",
      "accentSecondary": "#22d3ee",
      "border": "#1e293b",
      "badgeBg": "#082f49",
      "badgeText": "#7dd3fc"
    },
    "forest": {
      "name": "Forest Checklist",
      "background": "#05140f",
      "surface": "#0a241b",
      "surfaceElevated": "#12382b",
      "textPrimary": "#ecfdf5",
      "textSecondary": "#a7f3d0",
      "textMuted": "#6ee7b7",
      "accent": "#34d399",
      "accentSecondary": "#10b981",
      "border": "#144936",
      "badgeBg": "#064e3b",
      "badgeText": "#6ee7b7"
    },
    "paper": {
      "name": "Clean Notebook",
      "background": "#fafaf9",
      "surface": "#ffffff",
      "surfaceElevated": "#f5f5f4",
      "textPrimary": "#1c1917",
      "textSecondary": "#44403c",
      "textMuted": "#57534e",
      "accent": "#2563eb",
      "accentSecondary": "#1d4ed8",
      "border": "#e7e5e4",
      "badgeBg": "#dbeafe",
      "badgeText": "#1e40af"
    }
  },
  "slots": {
    "category": {
      "type": "string",
      "label": "Playbook Label",
      "description": "Short category label above the title.",
      "required": false,
      "maxLength": 30,
      "defaultValue": "4-STEP WORKFLOW"
    },
    "title": {
      "type": "string",
      "label": "Checklist Title",
      "description": "Main workflow headline.",
      "required": true,
      "maxLength": 96,
      "recommendedMaxLength": 68,
      "maxLines": 2,
      "autofit": {
        "minFontPx": 28,
        "maxFontPx": 44,
        "maxLines": 2
      }
    },
    "steps": {
      "type": "string[]",
      "label": "Workflow Steps",
      "description": "3 to 5 sequential action steps.",
      "required": true,
      "minItems": 3,
      "maxItems": 5,
      "maxLength": 110,
      "recommendedMaxLength": 90
    },
    "outcome": {
      "type": "string",
      "label": "Result / Outcome Note",
      "description": "Bottom summary of what completing the steps achieves.",
      "required": false,
      "maxLength": 90,
      "defaultValue": "Result: Pixel-accurate social assets in < 4 seconds."
    }
  },
  "sampleData": {
    "category": "MCP AGENT WORKFLOW",
    "title": "From Long-Form Article to Social Pack in 4 Steps",
    "steps": [
      "Inspect template schema and slot limits via get_template_schema.",
      "Distill source copy into structured JSON slots with your coding agent.",
      "Run validate_template_data and preview_post to verify zero overflow.",
      "Export final PNG, multi-page LinkedIn PDF, or 30fps MP4 via render_post."
    ],
    "outcome": "Result: Zero cloud design APIs, 100% deterministic local output."
  },
  "author": "AJ Rahim",
  "license": "MIT"
}
