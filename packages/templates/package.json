{
  "name": "@tinytldr/templates",
  "version": "0.1.0",
  "description": "Built-in MIT social post templates and bundled OFL fonts for tinytldr.",
  "license": "MIT",
  "author": "AJ Rahim",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/BrowserCatalog.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tinytldr/core": "workspace:*"
  }
}
