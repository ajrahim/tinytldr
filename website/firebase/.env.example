# Copy to .env.<your-project-id>; never commit the deployment-specific copy.
TINYTLDR_ALLOWED_ORIGINS=https://www.tinytldr.com,http://localhost:5173,http://127.0.0.1:5173
# Private, persistent Firebase Storage bucket. No whole-bucket expiry lifecycle.
TINYTLDR_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Optional exact trusted HTTPS endpoints for compatible providers; denied by default.
TINYTLDR_AI_CUSTOM_BASE_URLS=
# Provision TINYTLDR_AI_ENCRYPTION_KEY through Firebase Secret Manager, not this file.
