{
  "name": "tinytldr-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source MCP server, deterministic rendering engine, and website that turn anything into polished social posts from templates.",
  "license": "MIT",
  "author": "AJ Rahim",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajrahim/tinytldr.git"
  },
  "bugs": {
    "url": "https://github.com/ajrahim/tinytldr/issues"
  },
  "homepage": "https://www.tinytldr.com",
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:licenses": "node scripts/CheckLicenses.mjs",
    "deploy:hosted": "node scripts/DeployHosted.mjs",
    "test": "vitest run",
    "test:golden": "TINYTLDR_GOLDEN=1 vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:licenses && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  }
}
