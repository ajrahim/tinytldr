# Optional render server for PNG/JPEG/WebP, PDF, and MP4 exports.
VITE_TINYTLDR_API_URL=http://127.0.0.1:8787

# Public Firebase web SDK configuration. Do not put server credentials here.
VITE_TINYTLDR_FIREBASE_API_KEY=your-public-firebase-web-api-key
VITE_TINYTLDR_FIREBASE_PROJECT_ID=your-project-id
VITE_TINYTLDR_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_TINYTLDR_FIREBASE_APP_ID=your-web-app-id
VITE_TINYTLDR_FIREBASE_DESIGNS_URL=https://your-deployed-design-function
VITE_TINYTLDR_FIREBASE_AI_URL=https://your-deployed-ai-function
VITE_TINYTLDR_FIREBASE_MEDIA_URL=https://your-deployed-media-function
