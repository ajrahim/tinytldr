# Copy to .hosted/hosted.env (git-ignored). Deployment is explicit, never automatic.
# Public configuration only: never put service-account keys or provider keys here.
TINYTLDR_FIREBASE_PROJECT_ID=your-firebase-project-id

# Public Firebase web SDK configuration (also passed to Cloud Build as substitutions).
FIREBASE_API_KEY=your-public-firebase-web-api-key
FIREBASE_APP_ID=your-web-app-id
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# Firebase Hosting builds website/dist and routes authenticated export traffic to
# a SEPARATE Cloud Run service. Never point this service at the MCP service.
TINYTLDR_FIREBASE_HOSTING_SITE=your-firebase-hosting-site-id
# Optional separate Hosting site for api.tinytldr.com. When set, every request on
# this site proxies to the API service; it never serves website files.
TINYTLDR_API_HOSTING_SITE=your-api-hosting-site-id
# Must match the deployed Functions region.
TINYTLDR_FIREBASE_FUNCTIONS_REGION=us-central1
TINYTLDR_API_SERVICE_ID=tinytldr-api
TINYTLDR_API_REGION=us-central1
TINYTLDR_API_PUBLIC_URL=https://api.tinytldr.com
TINYTLDR_API_ALLOWED_ORIGINS=https://www.tinytldr.com

# Connect www and api custom domains to their respective Firebase Hosting sites;
# deployment never changes DNS. Without an API Hosting site, configure the API
# domain's routing separately. The website also has a same-origin /v1/** rewrite.
VITE_TINYTLDR_API_URL=https://api.tinytldr.com
VITE_TINYTLDR_FIREBASE_DESIGNS_URL=/api/designs
VITE_TINYTLDR_FIREBASE_AI_URL=/api/ai
VITE_TINYTLDR_FIREBASE_MEDIA_URL=/api/media

# Configure the same value in website/firebase/.env.<project-id>.
# Library files are persistent; never apply the temporary render bucket's deletion
# lifecycle to this Firebase Storage bucket. Direct client access stays denied.
TINYTLDR_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Runtime ADC identity must have Firebase Auth verification, Firestore transaction
# access, and object create/get/delete permissions for this private API-only bucket.
# Never enable public bucket access. Set a bucket lifecycle delete policy (e.g. 1 day).
# API URLs expire after five minutes and require the owning user's Firebase ID token.
TINYTLDR_API_ARTIFACT_BUCKET=your-private-website-render-bucket
TINYTLDR_API_DATABASE_ID=(default)
TINYTLDR_API_SERVICE_ACCOUNT=your-api-service-account@your-firebase-project-id.iam.gserviceaccount.com
TINYTLDR_API_IMAGE=us-central1-docker.pkg.dev/your-firebase-project-id/your-repository/tinytldr-api:latest

# Explicit API deployment: pnpm deploy:hosted api
# Default Firebase deployment: pnpm deploy:hosted
# Distributed websiteRenderLimits.ttlAt TTL is declared in firestore.indexes.json.
# Firebase Functions also require their runtime TINYTLDR_ALLOWED_ORIGINS to contain
# https://www.tinytldr.com; provider secrets stay in Secret Manager, never this file.
# Existing MCP issuer and https://mcp.tinytldr.com/mcp remain on their own service.
